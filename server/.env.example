PORT=5001
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/legendary_motors?retryWrites=true&w=majority
CLIENT_URL=https://your-legendary-client.vercel.app
ADMIN_URL=https://your-legendary-admin.vercel.app
ALLOWED_ORIGINS=https://your-legendary-client.vercel.app,https://your-legendary-admin.vercel.app
NODE_ENV=production

# Resend Email API (Recommended for modern cloud delivery & Vercel/Render)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=Legendary Motors <onboarding@resend.dev>

# Email notifications fallback (Optional - Nodemailer Gmail / SMTP)
SMTP_SERVICE=gmail
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Admin dashboard master authentication key
ADMIN_KEY=legendary-admin-2026
